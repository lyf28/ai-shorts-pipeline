# Provider selection. "local" runs completely offline and needs no API key.
LLM_PROVIDER=local
IMAGE_PROVIDER=local
TTS_PROVIDER=local
VIDEO_PROVIDER=local

# Optional OpenAI LLM settings. They are deliberately never embedded in source.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_IMAGE_MODEL=gpt-image-2.5-flare
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=alloy

# Optional Runway image-to-video settings. Keep the key only in an untracked .env file.
RUNWAY_API_KEY=
RUNWAY_VIDEO_MODEL=gen4_turbo
RUNWAY_VIDEO_DURATION_SECONDS=4
# Operator-provided estimate used to enforce the per-run budget before requests are sent.
RUNWAY_VIDEO_COST_PER_SECOND_USD=0.05
MAX_VIDEO_SECONDS_PER_RUN=12
MAX_VIDEO_COST_PER_RUN_USD=0.75

# Optional explicit path to ffmpeg/ffprobe.
FFMPEG_BIN=
FFPROBE_BIN=

# Runtime controls
PIPELINE_TIMEOUT_SECONDS=180
PIPELINE_RETRIES=2
