# Provider selection. "local" runs completely offline and needs no API key.
LLM_PROVIDER=local
VIDEO_PROVIDER=local
TTS_PROVIDER=local

# Optional provider credentials. They are deliberately never embedded in source.
OPENAI_API_KEY=

# Optional explicit path to ffmpeg/ffprobe.
FFMPEG_BIN=
FFPROBE_BIN=

# Runtime controls
PIPELINE_TIMEOUT_SECONDS=180
PIPELINE_RETRIES=2
